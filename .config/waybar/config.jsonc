{
  "position": "top",
  "modules-left": ["hyprland/workspaces"],
  "modules-center": ["hyprland/window"],
  "modules-right": [
    "custom/fullscreen",
    "network",
    "custom/fcitx",
    "pulseaudio",
    "bluetooth",
    "power-profiles-daemon",
    "idle_inhibitor",
    "battery",
    "clock",
  ],
  "clock": {
    "format": "<span foreground='#f5c2e7'></span> {:%a %d %H:%M}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "gnome-calendar",
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "<span foreground='#a6e3a1'>{icon}</span> {capacity}%",
    "format-warning": "<span foreground='#B1E3AD'>{icon}</span> {capacity}%",
    "format-critical": "<span foreground='#E38C8F'>{icon}</span> {capacity}%",
    "format-charging": "<span foreground='#B1E3AD'></span> {capacity}%",
    "format-plugged": "<span foreground='#B1E3AD'></span> {capacity}%",
    "format-alt": "<span foreground='#B1E3AD'>{icon}</span> {time}",
    "format-full": "<span foreground='#B1E3AD'></span> {capacity}%",
    "format-icons": ["", "", "", "", ""],
    "tooltip-format": "{time}",
  },
  "custom/fcitx": {
    "format": "<span foreground='#cba6f7'>󰌌</span> {}",
    "exec": "~/.config/waybar/scripts/fcitx-monitor.sh",
    "restart-interval": 0,
    "tooltip": true,
    "tooltip-format": "Input Method: {}",
    "on-click": "fcitx5-remote -t || fcitx-remote -t",
  },
  "network": {
    "format-wifi": "{icon}",
    "format-ethernet": "{icon}",
    "format-linked": "{ifname} (No IP) ",
    "format-disconnected": "{icon}",
    "format-icons": {
      "wifi": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
      "ethernet": "󰤭",
      "disconnected": "󰤮",
    },
    "tooltip-format-wifi": "{essid}\nSignal: {signalStrength}%",
    "tooltip-format-ethernet": "{ifname}\nIP: {ipaddr}",
    "tooltip-format-disconnected": "Disconnected",
    "on-click": "kcmshell6 kcm_networkmanagement",
  },
  "custom/fullscreen": {
    "exec": "~/.config/waybar/scripts/fullscreen-indicator.sh",
    "return-type": "json",
    "format": "{}",
    "interval": 1,
    "tooltip": true,
  },
  "power-profiles-daemon": {
    "format": "<span foreground='#fab387'>{icon}</span>",
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
    "tooltip": true,
    "tooltip-format": "Power profile: {profile}\nDriver: {driver}",
    "on-click": "powerprofilesctl set performance",
    "on-click-middle": "powerprofilesctl set balanced",
    "on-click-right": "powerprofilesctl set power-saver",
  },
  "bluetooth": {
    "format": "<span foreground='#89b4fa'></span>",
    "format-connected": "<span foreground='#89b4fa'></span>",
    "format-connected-battery": "<span foreground='#89b4fa'></span>",
    "format-disabled": "<span foreground='#E38C8F'></span>",
    "tooltip-format": "{controller_alias} ({controller_address})\n{status}",
    "tooltip-format-connected": "{controller_alias} ({controller_address})\n{num_connections} connected\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias} [{device_address}]",
    "tooltip-format-enumerate-connected-battery": "{device_alias} [{device_address}] {device_battery_percentage}%",
    "on-click": "kcmshell6 kcm_bluetooth",
  },
  "idle_inhibitor": {
    "format": "<span foreground='#a6e3a1'>{icon}</span>",
    "format-icons": {
      "activated": "󰅶",
      "deactivated": "󰾪",
    },
    "tooltip": true,
    "tooltip-format-activated": "Idle inhibitor: Active\nSystem will not sleep",
    "tooltip-format-deactivated": "Idle inhibitor: Inactive\nSystem can sleep normally",
  },
  "pulseaudio": {
    "format": "{icon} {volume}%",
    "format-muted": "",
    "format-icons": {
      "default": ["", "", ""],
    },
    "on-click": "kcmshell6 kcm_pulseaudio",
  },
}
